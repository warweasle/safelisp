(... (PRINT (NULL? NULL))
     (PRINT (NULL? 5))
     (PRINT (CONS? (LIST 1 2)))
     (PRINT (CONS? 5))
     (PRINT (SYMBOL? 'FOO))
     (PRINT (SYMBOL? 5))
     (PRINT (STRING? "hi"))
     (PRINT (STRING? 5))
     (PRINT (INT? 5))
     (PRINT (INT? 5.0))
     (PRINT (FLOAT? 5.0))
     (PRINT (FLOAT? 5))
     (PRINT (RATIONAL? (/ 1 3)))
     (PRINT (RATIONAL? 5))
     (PRINT (NUMBER? 5))
     (PRINT (NUMBER? 5.0))
     (PRINT (NUMBER? (/ 1 3)))
     (PRINT (NUMBER? "hi"))
     (PRINT (PROCEDURE? (LAMBDA (X) X)))
     (PRINT (PROCEDURE? +))
     (PRINT (PROCEDURE? 5))
     (PRINT (ZERO? 0))
     (PRINT (ZERO? 5)))
