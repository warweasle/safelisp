(... (PRINT (LEN "hello"))
     (PRINT (LEN (LIST 1 2 3)))
     (PRINT (LEN NULL))
     (PRINT (SUBSTR "hello world" 0 5))
     (PRINT (SUBSTR "hello world" 6 11))
     (PRINT (STRREF "hello" 0))
     (PRINT (STRREF "hello" 4))
     (PRINT (STRUPPER "hello"))
     (PRINT (STRLOWER "HELLO"))
     (PRINT (STREQ "abc" "abc"))
     (PRINT (STREQ "abc" "abd")))
