(... (SET ALLKEYS NULL)
     (SET DELKEYS NULL)
     (SET N 0)
     (<> (?... (((== N 1000000) (BREAK NULL))))
         (SET K (TOSTRING N))
         (SET ALLKEYS (CONS K ALLKEYS))
         (?? (== 0 (MOD N 2))
             (SET DELKEYS (CONS K DELKEYS)))
         (SET N (+ N 1)))

     (SET M (MAPMAKE))
     (SET CUR ALLKEYS)
     (<> (?... (((! CUR) (BREAK NULL))))
         (MAPADD M (CAR CUR) 1)
         (SET CUR (CDR CUR)))

     (SET CUR DELKEYS)
     (<> (?... (((! CUR) (BREAK NULL))))
         (MAPDEL M (CAR CUR))
         (SET CUR (CDR CUR)))

     (PRINT (LIST (MAPGET M (TOSTRING 0)) (MAPGET M (TOSTRING 1))
                  (MAPGET M (TOSTRING 999998)) (MAPGET M (TOSTRING 999999)))))
